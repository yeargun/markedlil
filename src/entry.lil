import { parseMarkdown, optionBool } from "./parse.lil";

bool defaultGfm = true;
bool defaultBreaks = false;
bool defaultPedantic = false;
bool defaultSilent = false;

JsValue mergeOpt(JsValue opt) {
  if (JS.isUndefined(opt) || JS.isNullish(opt)) {
    JsValue next = JS.object();
    next["gfm"] = defaultGfm;
    next["breaks"] = defaultBreaks;
    next["pedantic"] = defaultPedantic;
    next["silent"] = defaultSilent;
    return next;
  }
  JsValue next = JS.object();
  next["gfm"] = optionBool(opt, "gfm", defaultGfm);
  next["breaks"] = optionBool(opt, "breaks", defaultBreaks);
  next["pedantic"] = optionBool(opt, "pedantic", defaultPedantic);
  next["silent"] = optionBool(opt, "silent", defaultSilent);
  return next;
}

export string parse(string src, JsValue opt) {
  return parseMarkdown(src, true, mergeOpt(opt));
}

export string parseInline(string src, JsValue opt) {
  return parseMarkdown(src, false, mergeOpt(opt));
}

export JsValue setOptions(JsValue opt) {
  defaultGfm = optionBool(opt, "gfm", defaultGfm);
  defaultBreaks = optionBool(opt, "breaks", defaultBreaks);
  defaultPedantic = optionBool(opt, "pedantic", defaultPedantic);
  defaultSilent = optionBool(opt, "silent", defaultSilent);
  return getDefaults();
}

export JsValue getDefaults() {
  JsValue opt = JS.object();
  opt["gfm"] = true;
  opt["breaks"] = false;
  opt["pedantic"] = false;
  opt["silent"] = false;
  opt["async"] = false;
  return opt;
}

export JsValue options() {
  JsValue opt = JS.object();
  opt["gfm"] = defaultGfm;
  opt["breaks"] = defaultBreaks;
  opt["pedantic"] = defaultPedantic;
  opt["silent"] = defaultSilent;
  opt["async"] = false;
  return opt;
}

extern JsValue TypeError;

JsValue markedCall(JsValue self, JsValue src, JsValue opt) {
  if (!(src is string)) {
    throw JS.construct(TypeError, "marked(): input must be a string");
  }
  return parse(src, opt);
}

export JsValue marked = JS.method2(markedCall);

JsValue setOptionsCall(JsValue self, JsValue opt) {
  setOptions(opt);
  marked["defaults"] = options();
  return marked;
}

JsValue attachApi() {
  JsValue set = JS.method1(setOptionsCall);
  marked["parse"] = marked;
  marked["parseInline"] = parseInline;
  marked["setOptions"] = set;
  marked["options"] = set;
  marked["getDefaults"] = getDefaults;
  marked["defaults"] = options();
  return marked;
}

export JsValue default = attachApi();
