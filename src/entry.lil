import { MarkedApi, MarkedOptions } from "./types.lil";
import { parseMarkdown, optionFlag } from "./parse.lil";

JsValue liveDefaults = JS.object();

JsValue copyOptions(MarkedOptions source, bool fallbackGfm, bool fallbackBreaks, bool fallbackPedantic, bool fallbackSilent) {
  MarkedOptions next = JS.assume(JS.object());
  next.gfm = optionFlag(source.gfm, fallbackGfm);
  next.breaks = optionFlag(source.breaks, fallbackBreaks);
  next.pedantic = optionFlag(source.pedantic, fallbackPedantic);
  next.silent = optionFlag(source.silent, fallbackSilent);
  next.async = false;
  return next;
}

JsValue mergeOpt(JsValue opt) {
  MarkedOptions current = JS.assume(liveDefaults);
  if (JS.isUndefined(opt) || JS.isNullish(opt)) {
    return copyOptions(current, true, false, false, false);
  }
  return copyOptions(JS.assume(opt), optionFlag(current.gfm, true), optionFlag(current.breaks, false), optionFlag(current.pedantic, false), optionFlag(current.silent, false));
}

export string parse(string src, JsValue opt) {
  return parseMarkdown(src, true, mergeOpt(opt));
}

export string parseInline(string src, JsValue opt) {
  return parseMarkdown(src, false, mergeOpt(opt));
}

export JsValue setOptions(JsValue opt) {
  if (!(JS.isUndefined(opt) || JS.isNullish(opt))) {
    MarkedOptions current = JS.assume(liveDefaults);
    MarkedOptions incoming = JS.assume(opt);
    current.gfm = optionFlag(incoming.gfm, optionFlag(current.gfm, true));
    current.breaks = optionFlag(incoming.breaks, optionFlag(current.breaks, false));
    current.pedantic = optionFlag(incoming.pedantic, optionFlag(current.pedantic, false));
    current.silent = optionFlag(incoming.silent, optionFlag(current.silent, false));
  }
  return getDefaults();
}

export JsValue getDefaults() {
  MarkedOptions opt = JS.assume(JS.object());
  opt.gfm = true;
  opt.breaks = false;
  opt.pedantic = false;
  opt.silent = false;
  opt.async = false;
  return opt;
}

export JsValue options() {
  return copyOptions(JS.assume(liveDefaults), true, false, false, false);
}

extern JsValue TypeError;

JsValue markedCall(JsValue self, JsValue src, JsValue opt) {
  if (!(src is string)) {
    throw JS.construct(TypeError, "marked(): input must be a string");
  }
  return parse(src, opt);
}

export JsValue marked = JS.method2(markedCall);

JsValue setOptionsCall(JsValue self, JsValue opt) {
  setOptions(opt);
  MarkedApi api = JS.assume(marked);
  api.defaults = liveDefaults;
  return marked;
}

JsValue attachApi() {
  MarkedOptions current = JS.assume(liveDefaults);
  current.gfm = true;
  current.breaks = false;
  current.pedantic = false;
  current.silent = false;
  current.async = false;
  MarkedApi api = JS.assume(marked);
  JsValue set = JS.method1(setOptionsCall);
  api.parse = marked;
  api.parseInline = parseInline;
  api.setOptions = set;
  api.options = set;
  api.getDefaults = getDefaults;
  api.defaults = liveDefaults;
  return api;
}

export JsValue default = attachApi();
